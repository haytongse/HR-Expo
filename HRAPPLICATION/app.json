{
  "expo": {
    "name": "HRAPPLICATION",
    "slug": "hrapplication",
    "version": "1.0.0",
    "orientation": "portrait",
    "ios": {
      "bundleIdentifier": "com.hrd.hrapplication",
      "supportsTablet": false,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "com.hrd.hrapplication"
    },
    "plugins": [
      "expo-document-picker",
      [
        "expo-notifications",
        {
          "color": "#6366F1",
          "androidMode": "default"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to scan QR codes."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location to verify campus check-in."
        }
      ]
    ]
  }
}
